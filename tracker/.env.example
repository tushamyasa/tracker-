# PostgreSQL. Для локальной разработки запустите `npm run db:local` (PGlite, ничего ставить не нужно)
# и используйте этот адрес. В production укажите адрес управляемой базы (Neon, Supabase, Vercel Postgres).
# Для Neon и других пулов подключений добавьте в конец ?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?connection_limit=1&pgbouncer=true&sslmode=disable"

# Секрет подписи сессий. Сгенерируйте случайную строку не короче 32 символов:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# В production значение-заглушка и короткие секреты отклоняются при запуске.
SESSION_SECRET="change-me-in-production-32-chars-min"

# Хранилище фото: если задан токен Vercel Blob, фото уходят туда, иначе в папку на диске.
# BLOB_READ_WRITE_TOKEN=
# BLOB_ACCESS=private       # private (по умолчанию) или public: как создано хранилище в Vercel
# UPLOAD_DIR=/var/lib/tracker/uploads   # папка фото без Blob (по умолчанию ./uploads)

# Вход по ссылке из письма (рекомендуется для публичного запуска), см. README:
# AUTH_MODE=email
# APP_URL=https://tracker.example.com
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="Трекер тренировок <no-reply@tracker.example.com>"
# Для отладки без SMTP: MAIL_TRANSPORT=console (письма в лог) или file (в папку MAIL_OUTBOX_DIR)

# Необязательно:
# AUTH_RATE_LIMIT=30        # попыток входа в минуту с одного адреса в режиме open (по умолчанию 30)
