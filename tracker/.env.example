# База данных SQLite. Относительный путь считается от папки prisma/.
# В production задайте абсолютный путь на постоянный диск, например file:/var/lib/tracker/app.db
DATABASE_URL="file:./dev.db"

# Секрет подписи сессий. Сгенерируйте случайную строку не короче 32 символов:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# В production значение-заглушка и короткие секреты отклоняются при запуске.
SESSION_SECRET="change-me-in-production-32-chars-min"

# Необязательно:
# AUTH_RATE_LIMIT=30        # попыток входа в минуту с одного адреса (по умолчанию 30)
# UPLOAD_DIR=/var/lib/tracker/uploads   # папка загруженных фото (по умолчанию ./uploads)
