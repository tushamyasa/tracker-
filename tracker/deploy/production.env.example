# Пример /etc/tracker.env для production с входом по ссылке из письма.
NODE_ENV=production
PORT=3000

DATABASE_URL=file:/var/lib/tracker/app.db
UPLOAD_DIR=/var/lib/tracker/uploads

# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Вход по одноразовой ссылке из письма (подтверждает владение почтой).
AUTH_MODE=email
APP_URL=https://tracker.example.com

# Отправка писем. Подойдёт любой SMTP-сервис (Postmark, Mailgun, SES, Brevo и т. п.).
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM="Трекер тренировок <no-reply@tracker.example.com>"
